{
  "name": "oz-skilltree",
  "version": "0.1.0",
  "private": false,
  "description": "Failure-aware execution protocol for AI-assisted software engineering.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "ai-assisted-software-engineering",
    "failure-prediction",
    "developer-tools",
    "protocol",
    "verification",
    "receipts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cipherholdingsllc/oz-skilltree.git"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "benchmarks/",
    "commands/",
    "docs/",
    "examples/",
    "field-receipts/",
    "recipes/",
    "registry/",
    "research/",
    "schemas/",
    "scripts/",
    "skills/",
    "tests/",
    "wiki/",
    "RELEASE.md"
  ],
  "scripts": {
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "check:links": "node scripts/check-doc-links.mjs",
    "check:private": "node scripts/check-private-leaks.mjs",
    "check:surfaces": "node scripts/check-stable-surfaces.mjs",
    "eval:structural": "node scripts/run-structural-evals.mjs",
    "fingerprint": "node scripts/context-fingerprint.mjs",
    "test": "npm run validate:schemas && npm run check:links && npm run check:private && npm run check:surfaces && npm run eval:structural"
  },
  "engines": {
    "node": ">=18"
  }
}

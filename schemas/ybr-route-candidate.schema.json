{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oz-skilltree/ybr-route-candidate.schema.json",
  "title": "YBRRouteCandidateReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_id",
    "route_name",
    "grade",
    "score_out_of_10",
    "threshold",
    "status",
    "score_reason",
    "reason_5_words",
    "failure_risk",
    "reversibility",
    "verification_strength",
    "time_to_value",
    "scope_fit",
    "counter_coverage",
    "producer_alignment",
    "why_rejected_or_selected",
    "receipt_status"
  ],
  "properties": {
    "route_id": { "type": "string" },
    "route_name": { "type": "string" },
    "grade": { "type": "string" },
    "score_out_of_10": { "type": "number", "minimum": 0, "maximum": 10 },
    "threshold": { "type": "string" },
    "status": { "enum": ["selected", "rejected", "reserved", "needs_recheck"] },
    "score_reason": { "type": "string" },
    "reason_5_words": { "type": "string" },
    "failure_risk": { "type": "string" },
    "reversibility": { "type": "string" },
    "verification_strength": { "type": "string" },
    "time_to_value": { "type": "string" },
    "scope_fit": { "type": "string" },
    "counter_coverage": { "type": "string" },
    "producer_alignment": { "type": "string" },
    "why_rejected_or_selected": { "type": "string" },
    "receipt_status": { "type": "string" }
  }
}

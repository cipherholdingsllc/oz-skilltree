{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oz-skilltree/scoring-receipt.schema.json",
  "title": "ScoringReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "grade", "score_out_of_10", "threshold", "decision", "reason"],
  "properties": {
    "receipt_id": { "type": "string" },
    "grade": { "type": "string" },
    "score_out_of_10": { "type": "number", "minimum": 0, "maximum": 10 },
    "threshold": { "type": "string" },
    "decision": { "type": "string" },
    "reason": { "type": "string" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oz-skilltree/ozreceipt.schema.json",
  "title": "OzReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "status",
    "goal",
    "lane",
    "source_of_truth",
    "repo_context",
    "approval_ceiling",
    "truth_state",
    "domain_stack",
    "candidate_universe_receipt",
    "failure_radar_mode",
    "top_failure_families",
    "countermap",
    "ybr_route",
    "execution_prompt",
    "stop_conditions",
    "truth_state_updates",
    "files_changed",
    "commands_run",
    "verification",
    "rejected_routes",
    "next_gate"
  ],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "closed", "blocked"] },
    "goal": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "minLength": 1 },
    "source_of_truth": { "type": "array", "items": { "type": "string" } },
    "repo_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "worktree", "root_path", "branch", "commit_sha"],
      "properties": {
        "repo": { "type": "string" },
        "worktree": { "type": "string" },
        "root_path": { "type": "string" },
        "branch": { "type": "string" },
        "commit_sha": { "type": "string" }
      }
    },
    "approval_ceiling": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8"] },
    "truth_state": { "enum": ["claimed", "observed", "verified", "committed", "pushed", "deployed", "delivered"] },
    "domain_stack": { "type": "array", "items": { "type": "string" } },
    "candidate_universe_receipt": { "type": "string" },
    "failure_radar_mode": { "enum": ["scan", "standard", "standard+", "deep-lite", "deep", "max"] },
    "top_failure_families": { "type": "array", "items": { "type": "string" } },
    "countermap": { "type": "object" },
    "ybr_route": { "type": "object" },
    "execution_prompt": { "type": "string" },
    "stop_conditions": { "type": "array", "items": { "type": "string" } },
    "truth_state_updates": { "type": "array", "items": { "type": "object" } },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "rejected_routes": { "type": "array", "items": { "type": "object" } },
    "next_gate": { "type": "string" },
    "scoring_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["grade", "score_out_of_10", "threshold", "status", "reason"],
        "properties": {
          "grade": { "type": "string" },
          "score_out_of_10": { "type": "number", "minimum": 0, "maximum": 10 },
          "threshold": { "type": "string" },
          "status": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "trigger_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger_name", "threshold", "actual_score", "triggered"],
        "properties": {
          "trigger_name": { "type": "string" },
          "threshold": { "type": "string" },
          "actual_score": { "type": "number", "minimum": 0, "maximum": 10 },
          "triggered": { "type": "boolean" },
          "skip_reason": { "type": "string" }
        }
      }
    },
    "negative_memory": { "type": "array", "items": { "type": "string" } },
    "negative_memory_retrieval": {
      "type": "object",
      "required": ["searched", "hits"],
      "properties": {
        "searched": { "type": "boolean" },
        "query_basis": { "type": "string" },
        "hits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "context_fingerprint": { "type": "object" },
    "truth_state_proof": { "type": "object" },
    "public_private_classification": { "enum": ["public_safe", "conditional", "private_internal"] }
  }
}

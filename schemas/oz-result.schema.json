{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oz-skilltree/oz-result.schema.json",
  "title": "OzResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "result_id",
    "truth_state_before",
    "truth_state_after",
    "counter_results",
    "negative_memory",
    "future_retrieval_tags",
    "changed_route_if_any",
    "files_changed",
    "commands_run",
    "verification",
    "closed",
    "next_gate"
  ],
  "properties": {
    "receipt_id": { "type": "string" },
    "result_id": { "type": "string" },
    "truth_state_before": { "enum": ["claimed", "observed", "verified", "committed", "pushed", "deployed", "delivered"] },
    "truth_state_after": { "enum": ["claimed", "observed", "verified", "committed", "pushed", "deployed", "delivered"] },
    "counter_results": { "type": "array", "items": { "type": "object" } },
    "negative_memory": { "type": "array", "items": { "type": "string" } },
    "future_retrieval_tags": { "type": "array", "items": { "type": "string" } },
    "changed_route_if_any": { "type": ["string", "null"] },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "closed": { "type": "boolean" },
    "next_gate": { "type": "string" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oz-skilltree/ozledger-entry.schema.json",
  "title": "OzLedgerEntry",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_entry_id", "receipt_id", "event_type", "truth_state", "relationships", "next_gate", "public_safe"],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oz-skilltree/countermap-receipt.schema.json",
  "title": "CountermapReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "mode",
    "counter_budget",
    "all_counters_selected",
    "counters_reserved",
    "counters_not_needed",
    "failure_to_counter_mapping",
    "verification_counters",
    "rollback_counters"
  ],
  "properties": {
    "receipt_id": { "type": "string" },
    "mode": { "enum": ["scan", "standard", "standard+", "deep-lite", "deep", "max"] },
    "counter_budget": { "type": "integer", "minimum": 1, "maximum": 50 },
    "all_counters_selected": { "type": "array", "items": { "type": "string" } },
    "counters_reserved": { "type": "array", "items": { "type": "string" } },
    "counters_not_needed": { "type": "array", "items": { "type": "string" } },
    "failure_to_counter_mapping": { "type": "array", "items": { "type": "object" } },
    "verification_counters": { "type": "array", "items": { "type": "string" } },
    "rollback_counters": { "type": "array", "items": { "type": "string" } }
  }
}
